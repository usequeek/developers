{
  "name": "queek-nextjs-headless",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal headless Queek storefront (Next.js App Router + public client API)",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test tests/unwrap.test.mjs",
    "spec:pull": "curl -sSf https://client.usequeek.com/openapi.json -o openapi.json",
    "types:gen": "openapi-typescript openapi.json -o lib/schema.d.ts",
    "types:pull": "yarn spec:pull && yarn types:gen",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@queekai/client-sdk": "^0.3.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0"
  }
}
