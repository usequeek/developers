# Copy to .env. Never commit .env: the secret key must stay on the server.

# Storefront API base URL. Test keys and live keys use the same one.
QUEEK_API_BASE=https://client.usequeek.com/v1

# Your dev store's secret key, from Developers > Dev stores in the Queek
# dashboard. It starts with sk_test_ and reaches only that dev store.
QUEEK_SECRET_KEY=
