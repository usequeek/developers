# Copy to .env (never commit .env — the browser must never see this key).
QUEEK_API_BASE=https://client.usequeek.com/v1
QUEEK_SECRET_KEY=

# Sandbox you can smoke-test against right now (publishable TEST key, safe to
# share — test store only, no real money or customer data):
#   QUEEK_SECRET_KEY=sk_test_J3OUdEMOrVKsVr5aTmsd7WezHt9uQAEf
# The key identifies the store: no per-store host is needed. Storefront and
# checkout URLs come back inside GET /store/info.
